{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stremiium.xyz/schemas/workflow-contract.schema.json",
  "title": "Stremiium Workflow Contract",
  "type": "object",
  "required": ["workflow_id", "version", "owner", "trigger", "inputs", "nodes", "edges", "outputs", "failure_handling", "approval"],
  "properties": {
    "workflow_id": { "type": "string", "pattern": "^[a-z0-9_\\-]+$" },
    "version": { "type": "string" },
    "owner": { "type": "string" },
    "trigger": { "type": "string" },
    "inputs": { "type": "array", "items": { "type": "string" } },
    "nodes": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["node_id", "kind", "contract"], "properties": { "node_id": { "type": "string" }, "kind": { "enum": ["agent", "service", "approval", "router", "barrier", "verify"] }, "contract": { "type": "string" } }, "additionalProperties": false } },
    "edges": { "type": "array", "items": { "type": "object", "required": ["from", "to", "data_dependency"], "properties": { "from": { "type": "string" }, "to": { "type": "string" }, "data_dependency": { "type": "string", "minLength": 1 } }, "additionalProperties": false } },
    "outputs": { "type": "array", "items": { "type": "string" } },
    "failure_handling": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "approval": { "type": "string" }
  },
  "additionalProperties": false
}
