{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stremiium.xyz/schemas/task-contract.schema.json",
  "type": "object",
  "required": ["task_id", "requester", "owner", "context_id", "priority", "input_refs", "acceptance_criteria"],
  "properties": {
    "task_id": { "type": "string", "minLength": 1 },
    "requester": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "context_id": { "type": "string", "minLength": 1 },
    "priority": { "enum": ["critical", "high", "medium", "low"] },
    "input_refs": { "type": "array", "items": { "type": "string" } },
    "acceptance_criteria": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "deadline": { "type": ["string", "null"], "format": "date-time" }
  },
  "additionalProperties": false
}
